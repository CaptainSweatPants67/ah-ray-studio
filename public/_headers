/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; img-src 'self' blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/studio/fx.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate

/studio/fx-manifest.json
  Cache-Control: public, max-age=0, must-revalidate
